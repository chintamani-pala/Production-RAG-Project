LITELLM_PRIMARY_CHAT_MODEL=put_model_name_here
LITELLM_FALLBACK_CHAT_MODEL=put_model_name_here
LITELLM_CHAT_API_KEY=put_your_own_key

LITELLM_EMBEDDING_MODEL_NAME=put_model_name_here
LITELLM_EMBEDDING_API_KEY=put_your_own_key

LANGCHAIN_API_KEY=put_your_own_key
